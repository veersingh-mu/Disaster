# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/floodpath
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/floodpath

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Object Storage (S3 / Cloudflare R2 / MinIO)
OBJECT_STORAGE_KEY=mock_storage_key
OBJECT_STORAGE_SECRET=mock_storage_secret
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_BUCKET=floodpath-scenarios

# External Geospatial APIs
DEM_API_KEY=optional_opentopography_or_usgs_key
MAP_TILE_API_KEY=optional_map_tile_key

# AI Intelligence & Tactical Briefing (Server-Side Only - Never expose in frontend)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# CORS & Network Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional Supabase Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
